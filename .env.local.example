# Copy to .env.local and fill in.
#
# Repository name/domain. If omitted, Treeify falls back to `repositoryName`
# in prismic.config.json (written by `npx prismic init`).
PRISMIC_REPO=

# Optional. A permanent Content API access token — only needed if the repo's
# Content API is NOT publicly readable. Create one in:
#   Prismic dashboard → Settings → API & Security → Generate an Access Token
PRISMIC_READ_TOKEN=
